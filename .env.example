# Published NPM image
NPM_IMAGE=ghcr.io/your-org/your-npm-image:latest

# Container and timezone
NPM_CONTAINER_NAME=npm
NPM_RESTART_POLICY=unless-stopped
TZ=UTC

# Host ports
NPM_HTTP_PORT=80
NPM_ADMIN_PORT=81
NPM_HTTPS_PORT=443

# Persistent host directories
NPM_DATA_DIR=/path/to/npm/data
NPM_LETSENCRYPT_DIR=/path/to/npm/letsencrypt

# Existing external Docker network
NPM_NETWORK_NAME=your_external_network
NPM_IPV4_ADDRESS=192.0.2.22
